{
  "name": "@aura/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "db:reset": "rm -f aura.db aura.db-shm aura.db-wal && tsx src/seed.ts --force",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx src/smoke.ts"
  },
  "dependencies": {
    "@aura/core": "*",
    "@fastify/cors": "10.0.1",
    "@fastify/static": "10.1.7",
    "better-sqlite3": "11.6.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.11",
    "@types/node": "22.9.0",
    "drizzle-kit": "0.28.1",
    "pino-pretty": "11.3.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
