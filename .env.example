# ---- storage -------------------------------------------------------------
# Embedded SQLite. No cloud service, no credentials, nothing to provision.
DATABASE_URL="file:./aura.db"

# ---- server --------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# ---- data sources --------------------------------------------------------
# Switching to a live feed is one value per source. The app core never changes;
# only the adapter class behind the interface does.
FLIGHT_SOURCE=mock-aidx     # | vendor-api
ZONE_SOURCE=mock-acris      # | acris-live
AODB_SOURCE=mock-file       # | vendor-rest

# Needed only when the matching source is not the mock:
# AIDX_ENDPOINT=
# AIDX_CLIENT_CERT=
# AODB_BASE_URL=
# AODB_API_KEY=
# ACRIS_BROKER_URL=

# ---- creative assistant --------------------------------------------------
# The default runs offline with no key, so the demo always works.
AI_PROVIDER=mock            # | openai | anthropic
# AI_ENDPOINT=
# AI_API_KEY=
# AI_MODEL=

# ---- client --------------------------------------------------------------
VITE_API_URL=/api

# What the QR codes on the passenger screens encode. A phone has to be able to
# reach it, so for a laptop demo this is the machine's LAN address — e.g.
# http://192.168.1.24:4000. Leave it unset and the client uses its own origin,
# which is already correct when the reviewer opened the app over the LAN.
# PUBLIC_BASE_URL=http://192.168.1.24:4000
